# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Every feature is optional: the site still runs without any of these.

# Postgres (Neon via the Vercel Marketplace). Enables the contact inbox and editable projects.
DATABASE_URL=

# Admin dashboard at /admin
ADMIN_PASSWORD=
# Any long random string (e.g. `openssl rand -hex 32`); signs the admin session cookie
ADMIN_SECRET=

# "Ask about me" chat (Anthropic API key from console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: email notification for new messages (resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional: raises GitHub API rate limit (a fine-grained token with public read access)
GITHUB_TOKEN=
GITHUB_USERNAME=Swayam1129
